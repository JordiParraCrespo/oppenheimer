// A query reads its key from its feature's key factory, and never the root.
//
// An inline array is a key no invalidation can find by name, and `all` handed
// to a query stops meaning "everything this feature caches" the day a second
// query joins it. See apps/docs/docs/architecture/query-keys.md.
language js

or {
  `useQuery({ $props })`,
  `useSuspenseQuery({ $props })`,
  `useInfiniteQuery({ $props })`,
  `queryOptions({ $props })`
} where {
  $props <: some `queryKey: $key`,
  $key <: or {
    `[$_]`,
    r"^\w+Keys\.all$"
  },
  register_diagnostic(span=$key, message="Take a query's key from its feature's key factory (`thingsKeys.detail(id)`), never an inline array or the root `thingsKeys.all`.")
}
