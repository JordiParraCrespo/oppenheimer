# ==============================================================================
# Oppenheimer — environment configuration
#
# There is ONE `.env`, at the root of the repo, and this file is its
# documentation. Copy it to get started:
#
#   cp .env.example .env
#
# The rules that keep it honest:
#   - Every variable the repo reads is in this file, with a note on what it
#     does; nothing that is not read is in it.
#   - If you add a variable, add it here with a note. Never add a per-package
#     `.env` — `@oppenheimer/env` (packages/env) and Vite's `envDir` only look here.
#   - Real environment variables always win over this file. `@oppenheimer/env` never
#     overwrites a value already in `process.env`, which is what makes the same
#     code correct in CI and in production containers.
#   - `.env.local` (gitignored) overrides `.env` for machine-local tweaks.
#
# ⚠ Footgun: `vercel env pull` writes `.env.local`, which overrides `.env` —
#   silently pointing local development at whatever that Vercel project uses
#   (e.g. the production database). Check `.env.local` first when values seem
#   to come from nowhere.
#
# ⚠ `VITE_*` and `EXPO_PUBLIC_*` values are baked into the client bundles at
#   build time and are PUBLIC. Never put a secret in them.
# ==============================================================================

# ------------------------------------------------------------------------------
# API (apps/api)
# ------------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
# Port the API listens on
PORT=3001
# Public URL of the web app (CORS, trusted origin, the links auth sends people to)
FRONTEND_URL=http://localhost:3000
# Base of the RFC 7807 `type` URIs in error responses (documents the catalog)
ERROR_TYPE_BASE_URL=https://oppenheimer.dev/errors
# Number of reverse-proxy hops in front of the API (Express `trust proxy`).
# 0 = direct connection. Behind nginx/an ingress set it to the hop count so
# `req.ip` is the real client — the rate limiter keys on it, and API-token IP
# allowlists and audit logs record it.
TRUST_PROXY=0
# Bull Board queue dashboard (/admin/queues). Mounted ONLY when both are set,
# and then behind HTTP Basic auth. Job payloads carry tokenized reset/invite
# URLs, so leave these empty to keep the dashboard off in any exposed
# deployment.
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=

# Better Auth
# Secret used to sign sessions. Generate a strong one: `openssl rand -base64 32`
# Required — the app refuses to boot without it. Optional features (OAuth,
# S3, SMTP/Resend) are the opposite: a missing key just disables the
# feature; check GET /health/capabilities to see what a deployment can do.
BETTER_AUTH_SECRET=change-me-in-production
# Public base URL of the API (used to build OAuth callback URLs; its protocol
# also decides whether session cookies are marked Secure)
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated user ids granted break-glass super-admin access via the
# Better Auth admin plugin (leave empty normally)
BETTER_AUTH_ADMIN_USER_IDS=
# Auth rate limiting (login/forgot-password/sign-up). On automatically in
# production; set to true to also enable it in a non-production deployment that
# faces the internet. Leave false in development/test so a local run or e2e
# suite that signs in repeatedly is not throttled.
AUTH_RATE_LIMIT_ENABLED=false

# Database (Postgres — `pnpm docker:up` starts one with these defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=oppenheimer
DB_PASSWORD=oppenheimer
DB_DATABASE=oppenheimer
# Log SQL queries at debug level (off by default — bound parameters are never logged)
DB_LOG_QUERIES=false
# Seed (development only). `pnpm --filter @oppenheimer/api seed` creates well-known
# admin/user accounts; override their passwords here so a shared database never
# gets the published defaults. Seeding refuses to run when NODE_ENV=production
# unless ALLOW_PRODUCTION_SEED=true (and then only with strong passwords set).
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
ALLOW_PRODUCTION_SEED=false

# Redis (cache + BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis password (optional). Set when Redis requires auth (`requirepass`);
# leave empty for an unauthenticated connection on a private network.
REDIS_PASSWORD=

# Email Provider: console | nodemailer | resend
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@oppenheimer.dev

# SMTP (only when EMAIL_PROVIDER=nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend (only when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Storage Provider: local | s3
STORAGE_PROVIDER=local
# Directory for uploads when STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# Absolute base the browser loads locally-stored files from (avatars). The API
# serves them under `${STORAGE_PUBLIC_URL}/uploads/...`, so this must be an
# origin the browser can reach the API at. Leave empty to default to
# BETTER_AUTH_URL (the API's own public URL); set it only when local files are
# fronted by a separate host/CDN. Ignored when STORAGE_PROVIDER=s3.
STORAGE_PUBLIC_URL=

# S3 (only when STORAGE_PROVIDER=s3; also works with Hetzner Object Storage,
# MinIO, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=oppenheimer
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OAuth - Google (optional — leave unset to disable Google sign-in)
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (optional — leave unset to disable GitHub sign-in)
# Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App for sessions (optional — every GitHub-backed route returns
# GITHUB_002 until all six are set; unset means a workspace has no repository
# access, not a broken API). A different App from the GITHUB_CLIENT_* sign-in
# provider above: register it with "request user authorization during
# installation" on, Contents + Metadata + Pull requests + Workflows, and the
# `installation` webhook pointed at POST /api/v1/github/webhook.
# Numeric App id from the App's settings page
GITHUB_APP_ID=
# The App's PEM private key; literal \n escapes in a one-line value are accepted
GITHUB_APP_PRIVATE_KEY=
# Webhook signing secret, verified as X-Hub-Signature-256 over the raw body
GITHUB_APP_WEBHOOK_SECRET=
# The App's OAuth pair, used once per install to prove the caller's claim
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The App's URL slug. `GET /health/capabilities` builds the console's install
# link from it, so the browser needs no copy of its own.
GITHUB_APP_SLUG=
# Where GitHub is. Both default to github.com and only need setting for a
# GitHub Enterprise Server — or for an end-to-end run, which points the first
# at a stub so the create path can be exercised without registering an App.
# They carry the `GITHUB_APP_` prefix because `GITHUB_API_URL` is a variable
# GitHub Actions defines in every step, and a real environment variable always
# wins over this file — so inside Actions that name is not ours to use.
GITHUB_APP_API_URL=
GITHUB_APP_OAUTH_URL=

# Hosts and the runner (optional — every host route returns HOSTS_004 until the
# three below are set, and nothing else in the API changes). A host belongs to
# the person who paired it and is usable from any of their workspaces.
# The control plane's own Ed25519 private key. A runner pins the fingerprint of
# its public half at registration and refuses to speak to anything else
# afterwards, so changing this key orphans every host already paired.
# Format: the base64 of the PKCS#8 DER — one line, no PEM header. Generate one
# with: openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
# A value that is not an Ed25519 key of that form counts as unset, so the host
# routes say "not configured" rather than handing out a fingerprint of the wrong
# thing.
CONTROL_PLANE_SIGNING_KEY=
# Where signed runner releases are fetched from. Handed to the runner at
# registration and used by its self-update.
RUNNER_RELEASE_BASE_URL=
# Release channel new hosts follow: stable | beta
RUNNER_RELEASE_CHANNEL=stable
# The installer script the one-line install command pipes into a shell. It is
# deploy-owned on purpose: a workspace-writable install string would be remote
# code execution on somebody's laptop.
RUNNER_INSTALL_URL=
# The origin a runner dials, and the audience it signs its boot assertions for.
# Leave empty to use BETTER_AUTH_URL (the API's own public URL), which is right
# unless runners reach the API on a different name than browsers do.
CONTROL_PLANE_URL=
#
# NOTE: F5 records the source address a pairing token was minted and redeemed
# from. Behind a reverse proxy those columns are the proxy's address until
# TRUST_PROXY above names the real number of hops.

# ---------------------------------------------------------------------------
# The LLM provider, and naming a session from its first prompt
# ---------------------------------------------------------------------------
# The LLM provider (`@oppenheimer/backend-llm`), for the short, best-effort
# calls the product makes — today, a session's title from its first prompt.
# Optional: with `none` (the default) nothing is sent anywhere, and every
# caller has a fallback that needs no model.
#
# `none`, `openrouter`, `together`, `anthropic`, or `openai-compatible`.
#
# `openrouter` is the recommended one: one key, every open-weights model
# (`google/…`, `qwen/…`, `mistralai/…`), switched by a string.
# `together` is the same idea on Together AI. `openai-compatible` is anything
# else that serves `POST {LLM_BASE_URL}/chat/completions` — Groq, Fireworks,
# vLLM, or a local Ollama, which is how a prompt never leaves the building.
LLM_PROVIDER=none
# The key the provider authenticates with. Required for `openrouter`,
# `together` and `anthropic`; optional for `openai-compatible` (a model on your
# own machine has none). A provider switched on without what it needs is simply
# not configured, and `GET /health/capabilities` reports it.
LLM_API_KEY=
# Where the provider lives, up to and including its `/v1`. Required for
# `openai-compatible`; the others have theirs built in and take this only as an
# override.
# Examples: https://api.groq.com/openai/v1 · http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
# The model a call uses when it names none, verbatim. No default in code: a
# model id is a moving target and a deployment picks its own.
# Recommended (OpenRouter): LLM_MODEL=google/gemma-3-12b-it — the fastest of the
# models compared for session titles (~0.3 s typical, well inside the naming
# deadline), clean titles, ~$0.000005 per title.
LLM_MODEL=
# How long any call may take before it is abandoned, in milliseconds.
LLM_TIMEOUT_MS=10000

# A session is named after its minted slug ("bold-otter-3f9a7k") until its first
# prompt exists. Then a model is asked for a title, with a short deadline; if it
# is not quick — or there is no provider — the session is named from the
# prompt's own opening words instead. The one line that leaves the host is that
# first prompt; the agent's transcript it was read from never leaves.
#
# A small, fast model for titles. Optional: falls back to LLM_MODEL. A
# non-reasoning model is the right pick — a title is six words, and a reasoning
# model spends the whole 32-token budget thinking and answers nothing.
SESSION_NAMER_MODEL=
# How long creating a session waits for the model's title before it names the
# session from the prompt instead, in milliseconds. It is on the create path,
# so keep it short.
SESSION_NAMER_TIMEOUT_MS=2000

# OPENAPI_GENERATION is read by apps/api but set automatically by
# `pnpm generate:openapi` (boots the module graph without a database).
# Never set it yourself.

# oppenheimer:begin web
# ------------------------------------------------------------------------------
# Web (apps/web) — VITE_* values are public and baked in at
# build time
# ------------------------------------------------------------------------------

# Leave empty in development: the Vite dev server proxies `/api` to the API
# (http://localhost:3001), keeping web and API same-origin so the session
# cookie is sent with every request. Set this only when the API is served from
# a different origin behind a shared domain in production.
VITE_API_URL=

# Analytics (PostHog)
# Leave the key empty to disable analytics entirely — the app falls back to a
# no-op client, the SDK is never downloaded, and every feature flag reads as
# off. Set it to your project key to enable.
VITE_POSTHOG_KEY=
# Defaults to the EU cloud region. Use https://us.i.posthog.com for a US
# project, or your own origin when self-hosting.
VITE_POSTHOG_HOST=
# oppenheimer:end web

# oppenheimer:begin runner
# ------------------------------------------------------------------------------
# Runner (apps/runner) — Go service the API delegates orchestration work to
# ------------------------------------------------------------------------------

# A paired host needs none of these: `runner register` writes everything it
# needs to ~/.oppenheimer/config.json. They configure `runner serve` (the
# control-plane-facing HTTP service, which is what the container runs) and the
# two overrides that let you develop a second runner on a machine that already
# hosts one.
#
# development | production | test. Outside production the service also reads
# this file (found by walking up to pnpm-workspace.yaml); real env vars win.
RUNNER_ENV=development
# Where the host agent keeps its identity, binaries, logs and socket.
# Development override only; the default is ~/.oppenheimer.
RUNNER_HOME=
# Where sessions' worktrees live. Development override only; the default is
# ~/oppenheimer-ai/workspaces.
RUNNER_WORKSPACES=
# Port the runner listens on
RUNNER_PORT=3006
# debug | info | warn | error
RUNNER_LOG_LEVEL=info
# json | text (defaults to json in production, text otherwise)
RUNNER_LOG_FORMAT=
# The one credential that exists before any key is issued. Holds every scope.
# Required — the service refuses to boot without it (>= 32 chars):
# `openssl rand -base64 32`. Use it once to mint narrower keys, then vault it.
RUNNER_BOOTSTRAP_API_KEY=change-me-in-production-at-least-32-chars
# Optional Postgres DSN. Empty keeps the in-memory stores (the default, fine
# for a stateless runner). When set, API keys are Postgres-backed
# and survive restarts; a `postgres` readiness check and capability turn on.
# `postgres://user:pass@host:5432/dbname?sslmode=disable`
RUNNER_DATABASE_URL=
# Optional: enables short-lived HS256 service tokens (POST /v1/service-tokens)
# for agents the runner bootstraps. Leave empty to keep the capability off;
# GET /health/capabilities lists `service_tokens` when it is on.
RUNNER_JWT_SECRET=
# `iss`/`aud` claims required on service tokens (default oppenheimer-runner)
RUNNER_JWT_ISSUER=
RUNNER_JWT_AUDIENCE=
# Service token lifetime (default 1h)
RUNNER_JWT_TTL=
# Reverse-proxy hops in front of the runner, same meaning as TRUST_PROXY
RUNNER_TRUST_PROXY=0
# Graceful shutdown budget for draining requests and WebSockets (default 15s)
RUNNER_SHUTDOWN_TIMEOUT=
# Maximum JSON request body in bytes (default 1048576)
RUNNER_MAX_BODY_BYTES=
# ERROR_TYPE_BASE_URL above is shared: the runner's problem `type` URIs point
# at the same error reference page.
# oppenheimer:end runner

# ------------------------------------------------------------------------------
# Docker Compose (docker/docker-compose.prod.yml) — read at `docker compose`
# time for image/DB interpolation, not by application code
# ------------------------------------------------------------------------------

# Images to deploy (CI pushes to GHCR)
API_IMAGE=
# oppenheimer:begin web
WEB_IMAGE=
# oppenheimer:end web
# oppenheimer:begin docs
DOCS_IMAGE=
# oppenheimer:end docs
# oppenheimer:begin runner
RUNNER_IMAGE=
# oppenheimer:end runner
