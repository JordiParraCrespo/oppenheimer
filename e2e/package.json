{
  "name": "@oppenheimer/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:api": "playwright test --project=api",
    "e2e:web": "playwright test --project=web",
    "e2e:ratelimit": "RUN_RATE_LIMIT=1 playwright test --project=api --workers=1 --grep @ratelimit",
    "lint": "biome check .",
    "report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@oppenheimer/env": "workspace:*"
  }
}
