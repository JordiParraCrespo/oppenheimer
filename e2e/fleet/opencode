#!/bin/sh
# Stands in for OpenCode: prints the argv the runner built, then hands the
# pane to an interactive shell, as the `claude` shim beside it does. The
# runner briefs OpenCode through OPENCODE_CONFIG_CONTENT, not its argv; that
# is kept whole in ~/opencode-config.log.
printf '%s\n' "${OPENCODE_CONFIG_CONTENT:-}" >> "$HOME/opencode-config.log"
printf 'OPENCODE-SHIM argv=%s\n' "$*"
exec sh -i
