#!/usr/bin/env bash
# oppctl — operate the Oppenheimer dev deployment on this server.
#
#   oppctl setup [--ci-key '<ssh public key>']   as root, from a checkout: install
#   oppctl doctor                                 is this server ready to deploy?
#   oppctl deploy <sha> <bundle-dir>              what the CI deploy gate runs
#   oppctl rollback                               back to the previous release
#   oppctl status | logs [service…] | psql
#   oppctl backup {daily|weekly|check}            dump → encrypt → R2 (weekly: B2)
#   oppctl restore                                plaintext pg_dump -Fc on stdin
#   oppctl publish-release [--check] <dir | ->    a signed runner release (-: a tar on stdin)
#
# Nothing is built here. A release is the deploy/dev directory of one commit
# plus `release.env`, which pins the images the `Deploy dev` workflow built for
# that commit by digest. Releases live in /srv/oppenheimer/releases;
# `current` and `previous` are symlinks into it.
#
# This program is not part of a release. `oppctl setup` installs it, root-owned,
# in /usr/local/libexec/oppenheimer beside the deploy gate, and everything —
# the gate, the timers, you — runs that copy, which operates on the release
# directory it is given. A release that changes it is installed by running
# setup again from that commit.

set -euo pipefail

ROOT="${OPP_ROOT:-/srv/oppenheimer}"
CONFIG="$ROOT/config"
RELEASES="$ROOT/releases"
CURRENT="$ROOT/current"
PREVIOUS="$ROOT/previous"
INFLIGHT="$ROOT/inflight"
LIBEXEC=/usr/local/libexec/oppenheimer
PROJECT=oppenheimer-dev
KEEP_RELEASES=5
HEALTH_TIMEOUT="${OPP_HEALTH_TIMEOUT:-300}"
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
APPS=(
  api
  # oppenheimer:begin web
  web
  # oppenheimer:end web
  backup
)

log()  { printf '[oppctl] %s\n' "$*" >&2; }
ok()   { printf '[oppctl] ok   %s\n' "$*" >&2; }
warn() { printf '[oppctl] warn %s\n' "$*" >&2; }
die()  { printf '[oppctl] FAIL %s\n' "$*" >&2; exit 1; }

load_host_env() {
  [ -r "$CONFIG/host.env" ] || die "no $CONFIG/host.env — run 'oppctl setup' as root first"
  set -a
  # shellcheck source=/dev/null
  . "$CONFIG/host.env"
  set +a
}

# Every compose call goes through here, so a release is always run with its own
# compose file and image pins and this server's settings.
compose() {
  local rel="$1"; shift
  OPP_CONFIG="$CONFIG" docker compose -p "$PROJECT" --project-directory "$rel" -f "$rel/compose.yml" \
    --env-file "$CONFIG/host.env" --env-file "$rel/release.env" "$@"
}

current_release() { readlink -e "$CURRENT" 2>/dev/null || true; }

need_current() {
  local rel; rel="$(current_release)"
  [ -n "$rel" ] && [ -d "$rel" ] || die "nothing is deployed yet"
  printf '%s' "$rel"
}

lock() {
  exec 9>"$ROOT/.lock"
  flock -w 900 9 || die "another oppctl deploy, rollback, backup or restore is still running"
}

notify() {
  [ -n "${NTFY_URL:-}" ] || return 0
  curl -fsS -m 10 -H "Title: oppenheimer-dev" -d "$*" "$NTFY_URL" >/dev/null 2>&1 \
    || warn "could not reach ntfy at $NTFY_URL"
}

# ---------------------------------------------------------------- checks ---

render_tunnel_config() {
  local rel="$1"
  sed -e "s|\${TUNNEL_ID}|$TUNNEL_ID|g" -e "s|\${DEV_HOSTNAME}|$DEV_HOSTNAME|g" \
    "$rel/cloudflared.yml.tmpl" > "$rel/cloudflared.yml"
}

# The properties the server's isolation rests on, checked on the resolved
# config of the release about to run, backup profile included.
check_invariants() {
  local rel="$1" cfg bad
  cfg="$(compose "$rel" --profile backup config --format json)" || die "compose rejected $rel/compose.yml"

  bad="$(jq -r '.services | to_entries[] | select((.value.ports // []) | length > 0) | .key' <<< "$cfg")"
  [ -z "$bad" ] || die "services publish ports to the host (ingress is the tunnel only): $bad"

  bad="$(jq -r '.services | to_entries[] | select(.value.image != null)
           | select((.value.image | test("@sha256:[0-9a-f]{64}$")) | not) | "\(.key)=\(.value.image)"' <<< "$cfg")"
  [ -z "$bad" ] || die "images not pinned by digest: $bad"

  jq -e '.networks.data.internal == true' >/dev/null <<< "$cfg" \
    || die "network 'data' is not internal — Postgres and Redis would have a route out"

  for svc in postgres redis; do
    [ "$(jq -r --arg s "$svc" '.services[$s].networks | keys | join(",")' <<< "$cfg")" = data ] \
      || die "$svc must be on the 'data' network only"
  done
  ok "compose invariants hold"
}

check_config() {
  local missing=0
  for f in api.env db_password backup_db_password rclone.conf tunnel-credentials.json; do
    [ -s "$CONFIG/$f" ] || { warn "missing or empty: $CONFIG/$f"; missing=1; }
  done
  # AGE_RECIPIENT and R2_BUCKET too: every deploy after the first starts with
  # a dump off the server, and a deploy that cannot take one does not run.
  for v in IMAGE_REPO DEV_HOSTNAME TUNNEL_ID AGE_RECIPIENT R2_BUCKET; do
    [ -n "${!v:-}" ] || { warn "$v is empty in $CONFIG/host.env"; missing=1; }
  done
  [ "$missing" -eq 0 ] || return 1
  jq -e '.TunnelID and .TunnelSecret' "$CONFIG/tunnel-credentials.json" >/dev/null 2>&1 \
    || { warn "tunnel-credentials.json is not a cloudflared tunnel credentials file"; return 1; }
  [ "$(jq -r .TunnelID "$CONFIG/tunnel-credentials.json")" = "$TUNNEL_ID" ] \
    || { warn "TUNNEL_ID does not match the credentials file's TunnelID"; return 1; }
  grep -q '^\[r2\]' "$CONFIG/rclone.conf" || { warn "rclone.conf has no [r2] remote"; return 1; }
}

container_of() { compose "$1" ps -q "$2" 2>/dev/null | head -1; }

wait_healthy() {
  local rel="$1" svc="$2" deadline=$((SECONDS + HEALTH_TIMEOUT)) id state
  while [ "$SECONDS" -lt "$deadline" ]; do
    id="$(container_of "$rel" "$svc")"
    if [ -n "$id" ]; then
      # Healthy means its healthcheck passed. A service the release checks
      # without one is a mistake in compose.yml, not a pass.
      state="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$id")"
      case "$state" in
        healthy) ok "$svc is healthy"; return 0 ;;
        unhealthy) warn "$svc is unhealthy"; return 1 ;;
        none) warn "$svc has no healthcheck"; return 1 ;;
      esac
    fi
    sleep 3
  done
  warn "$svc not healthy after ${HEALTH_TIMEOUT}s"
  return 1
}

# Healthy containers, then one request through the same path a browser takes
# minus Cloudflare: nginx → API → Postgres and Redis.
verify_release() {
  local rel="$1"
  wait_healthy "$rel" api || return 1
  # oppenheimer:begin web
  wait_healthy "$rel" web || return 1
  compose "$rel" exec -T web wget -qO- http://127.0.0.1:3000/api/v1/ready >/dev/null \
    || { warn "GET /api/v1/ready through nginx failed"; return 1; }
  ok "console → API → database and Redis answer"
  # oppenheimer:end web
  wait_healthy "$rel" cloudflared || return 1
}

# --------------------------------------------------------------- releases ---

# Pull this commit's images with the workflow's short-lived token, then pin
# each by the digest the registry served. No registry credential is kept: the
# config dir is temporary, and once pulled the images are local, so a restart
# or a rollback never needs the registry.
pull_images() {
  local sha="$1" token_file="$2" out="$3" ref digest var
  local dc; dc="$(mktemp -d)"
  [ -s "$token_file" ] || die "the bundle carries no registry token"
  DOCKER_CONFIG="$dc" docker login "${IMAGE_REPO%%/*}" -u oppenheimer-deploy --password-stdin < "$token_file" >/dev/null 2>&1 \
    || { rm -rf "$dc"; die "${IMAGE_REPO%%/*} refused the workflow's token"; }
  : > "$out"
  printf 'RELEASE_SHA=%s\n' "$sha" >> "$out"
  for app in "${APPS[@]}"; do
    ref="$IMAGE_REPO/oppenheimer-$app:$sha"
    log "pulling $ref"
    DOCKER_CONFIG="$dc" docker pull -q "$ref" >/dev/null || { rm -rf "$dc"; die "could not pull $ref"; }
    digest="$(docker image inspect -f '{{range .RepoDigests}}{{println .}}{{end}}' "$ref" \
               | grep -m1 "^$IMAGE_REPO/oppenheimer-$app@sha256:")" \
      || { rm -rf "$dc"; die "no registry digest recorded for $ref"; }
    var="$(printf '%s' "$app" | tr '[:lower:]' '[:upper:]')_IMAGE"
    printf '%s=%s\n' "$var" "$digest" >> "$out"
  done
  rm -rf "$dc"
}

swap_links() {
  local new="$1" old; old="$(current_release)"
  if [ -n "$old" ] && [ "$old" != "$new" ]; then ln -sfn "$old" "$PREVIOUS.tmp" && mv -Tf "$PREVIOUS.tmp" "$PREVIOUS"; fi
  ln -sfn "$new" "$CURRENT.tmp" && mv -Tf "$CURRENT.tmp" "$CURRENT"
}

# Each release's images stay tagged `:<sha>` so `docker image prune` never
# treats them as dangling: a rollback must not need the registry.
prune_releases() {
  local cur prev keep_shas name rel sha n=0
  cur="$(current_release)"; prev="$(readlink -e "$PREVIOUS" 2>/dev/null || true)"
  keep_shas="$(sed -n 's/^RELEASE_SHA=//p' "$cur/release.env" ${prev:+"$prev/release.env"})"
  # Newest first; release directories are named <sha12>-<UTC timestamp>.
  while read -r name; do
    rel="$RELEASES/$name"
    n=$((n + 1))
    [ "$n" -le "$KEEP_RELEASES" ] && continue
    [ "$rel" = "$cur" ] || [ "$rel" = "$prev" ] && continue
    log "pruning release $name"
    sha="$(sed -n 's/^RELEASE_SHA=//p' "$rel/release.env" 2>/dev/null || true)"
    if [ -n "$sha" ] && ! grep -qxF "$sha" <<< "$keep_shas"; then
      for app in "${APPS[@]}"; do
        docker image rm "$IMAGE_REPO/oppenheimer-$app:$sha" >/dev/null 2>&1 || true
      done
    fi
    rm -rf "$rel"
  done < <(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -t- -k2 -r)
  docker image prune -f >/dev/null 2>&1 || true
}

# What a deploy has done so far, for deploy_unwind.
DEPLOY_SHA="" DEPLOY_REL="" DEPLOY_PREV="" DEPLOY_STARTED=0 DEPLOY_DONE=0

# The one way a deploy ends without `current` moving: a failed check, a `die`,
# a signal. If the new release was started, the previous one is started again
# (a first deploy's is stopped instead), so the running containers are always
# the ones `current` names. `inflight` records a deploy in progress; one left
# behind means this process was killed outright, and `oppctl status` says so.
deploy_unwind() {
  [ "$DEPLOY_DONE" = 1 ] && return 0
  trap - EXIT INT TERM
  if [ "$DEPLOY_STARTED" = 1 ]; then
    compose "$DEPLOY_REL" ps || true
    compose "$DEPLOY_REL" logs --tail 80 api || true
    if [ -n "$DEPLOY_PREV" ]; then
      warn "rolling back to $(basename "$DEPLOY_PREV")"
      compose "$DEPLOY_PREV" up -d --remove-orphans || true
      verify_release "$DEPLOY_PREV" || warn "the previous release is not healthy either"
      warn "migrations that ran are NOT undone; if the previous API refuses the schema, restore the pre-deploy dump (README: Restore)"
    else
      warn "stopping the failed first release"
      compose "$DEPLOY_REL" stop || true
    fi
  fi
  rm -f "$INFLIGHT"
  notify "deploy of ${DEPLOY_SHA:0:12} failed"
  printf '[oppctl] FAIL deploy of %s failed\n' "$DEPLOY_SHA" >&2
  exit 1
}

cmd_deploy() {
  local sha="${1:-}" bundle="${2:-}"
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "usage: oppctl deploy <40-char sha> <bundle-dir>"
  [ -d "$bundle/deploy" ] || die "no deploy/ directory in $bundle"
  load_host_env
  check_config || die "this server is not configured — run 'oppctl doctor'"
  lock

  # A dropped SSH session must not stop a deploy halfway: hangups and broken
  # pipes are ignored, and the output also goes to deploy.log, so the deploy
  # finishes or unwinds on its own and can be read afterwards.
  trap '' HUP PIPE
  exec > >(tee -p -a "$ROOT/deploy.log") 2>&1
  DEPLOY_SHA="$sha"
  DEPLOY_PREV="$(current_release)"
  DEPLOY_REL="$RELEASES/${sha:0:12}-$(date -u +%Y%m%dT%H%M%SZ)"
  trap deploy_unwind EXIT
  trap 'exit 1' INT TERM
  log "$(date -u +%FT%TZ) deploying $sha as $(basename "$DEPLOY_REL")"
  cmp -s "$bundle/deploy/bin/oppctl" "${BASH_SOURCE[0]}" \
    || warn "this commit changes oppctl; install it with 'oppctl setup' from this commit"

  cp -a "$bundle/deploy" "$DEPLOY_REL"
  rm -f "$DEPLOY_REL/registry-token"
  pull_images "$sha" "$bundle/registry-token" "$DEPLOY_REL/release.env"
  render_tunnel_config "$DEPLOY_REL"
  check_invariants "$DEPLOY_REL"

  # A dump before the new API boots: migrations run at boot and only forward,
  # so this is what a bad migration is undone with. It runs with the incoming
  # release's backup image and scripts, so a fix to them ships with the deploy
  # that carries it.
  if [ -n "$DEPLOY_PREV" ] && [ -n "$(container_of "$DEPLOY_PREV" postgres)" ]; then
    backup_run "$DEPLOY_REL" daily || die "pre-deploy backup failed — not deploying over a database without one"
  fi

  ln -sfn "$DEPLOY_REL" "$INFLIGHT"
  DEPLOY_STARTED=1
  compose "$DEPLOY_REL" up -d --remove-orphans || die "compose up failed"
  verify_release "$DEPLOY_REL" || die "the new release is not healthy"

  swap_links "$DEPLOY_REL"
  DEPLOY_DONE=1
  rm -f "$INFLIGHT"
  ensure_backup_role "$DEPLOY_REL" || warn "could not refresh backup_user; the next backup will try again"
  prune_releases
  ok "deployed $sha"
}

cmd_rollback() {
  load_host_env
  lock
  local target cur
  target="$(readlink -e "$PREVIOUS" 2>/dev/null || true)"
  cur="$(need_current)"
  [ -n "$target" ] && [ -d "$target" ] || die "no previous release to roll back to"
  log "rolling back $(basename "$cur") → $(basename "$target")"
  warn "migrations are not reverted; the previous API must accept the current schema"
  compose "$target" up -d --remove-orphans
  verify_release "$target" || die "the previous release did not come up healthy"
  ln -sfn "$cur" "$PREVIOUS.tmp" && mv -Tf "$PREVIOUS.tmp" "$PREVIOUS"
  ln -sfn "$target" "$CURRENT.tmp" && mv -Tf "$CURRENT.tmp" "$CURRENT"
  ok "now running $(basename "$target")"
}

# ---------------------------------------------------------------- backups ---

# backup_user: pg_read_all_data and nothing else. Idempotent; the password is
# the hex string `oppctl setup` generated, so it needs no quoting.
ensure_backup_role() {
  local rel="$1" pw
  pw="$(cat "$CONFIG/backup_db_password")"
  [[ "$pw" =~ ^[0-9a-f]+$ ]] || die "backup_db_password must be hex (oppctl setup generates it)"
  compose "$rel" exec -T postgres psql -q -U oppenheimer -d oppenheimer -v ON_ERROR_STOP=1 >/dev/null <<SQL
SET client_min_messages = warning;
DO \$\$ BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'backup_user') THEN
    CREATE ROLE backup_user LOGIN;
  END IF;
END \$\$;
ALTER ROLE backup_user WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD '$pw';
GRANT pg_read_all_data TO backup_user;
SQL
}

# Dump and upload are two containers (one reads the database, the other
# reaches the internet), so the program that runs them in order is this one;
# upload.sh owns only the transfer. A dump that stays on this server is not a
# backup, so each step fails closed.
backup_run() {
  local rel="$1" mode="$2"
  case "$mode" in
    daily)
      [ -n "${AGE_RECIPIENT:-}" ] || { warn "AGE_RECIPIENT is unset in $CONFIG/host.env"; return 1; }
      [ -n "${R2_BUCKET:-}" ] || { warn "R2_BUCKET is unset in $CONFIG/host.env"; return 1; }
      ensure_backup_role "$rel" || return 1
      log "dumping"
      compose "$rel" run --rm -T backup-dump </dev/null || return 1
      compose "$rel" run --rm -T backup-upload daily </dev/null ;;
    weekly|check)
      compose "$rel" run --rm -T backup-upload "$mode" </dev/null ;;
    *) die "usage: oppctl backup {daily|weekly|check}" ;;
  esac
}

cmd_backup() {
  load_host_env
  local rel; rel="$(need_current)"
  lock
  if ! backup_run "$rel" "${1:-}"; then
    notify "backup ${1:-} failed on $(hostname)"
    die "backup ${1:-} failed"
  fi
  ok "backup ${1:-} done"
}

# Replace the database with a dump. The private key never comes here: decrypt
# on your own machine and stream the plaintext in over the tailnet —
#   age -d -i key.txt oppenheimer-….pgc.age | ssh admin@oppenheimer-dev \
#     sudo -u deploy OPP_CONFIRM=restore-oppenheimer-dev oppctl restore
cmd_restore() {
  [ "${OPP_CONFIRM:-}" = restore-oppenheimer-dev ] \
    || die "this replaces the dev database; set OPP_CONFIRM=restore-oppenheimer-dev"
  [ ! -t 0 ] || die "pipe a plaintext pg_dump -Fc file into stdin"
  load_host_env
  local rel; rel="$(need_current)"
  lock
  # Read all of stdin before anything else runs: the safety dump starts
  # containers, and nothing may consume the stream meant for pg_restore.
  local dump; dump="$(mktemp "$ROOT/.restore.XXXXXX")"
  trap 'rm -f "$dump"' EXIT
  log "receiving the dump"
  cat > "$dump"
  backup_run "$rel" daily || die "could not take a safety dump first"
  compose "$rel" exec -T postgres sh -c 'cat > /tmp/restore.pgc' < "$dump"
  rm -f "$dump"
  compose "$rel" exec -T postgres pg_restore -l /tmp/restore.pgc >/dev/null \
    || die "stdin is not a pg_dump custom-format archive"
  compose "$rel" stop cloudflared
  # oppenheimer:begin web
  compose "$rel" stop web
  # oppenheimer:end web
  compose "$rel" stop api
  compose "$rel" exec -T postgres psql -q -U oppenheimer -d postgres -v ON_ERROR_STOP=1 \
    -c 'DROP DATABASE IF EXISTS oppenheimer WITH (FORCE)' -c 'CREATE DATABASE oppenheimer OWNER oppenheimer'
  compose "$rel" exec -T postgres pg_restore -U oppenheimer -d oppenheimer --no-owner --exit-on-error /tmp/restore.pgc \
    || die "pg_restore failed; the database is partially restored and the API is stopped"
  compose "$rel" exec -T postgres rm -f /tmp/restore.pgc
  ensure_backup_role "$rel"
  compose "$rel" up -d
  verify_release "$rel" || die "restored, but the release did not come back healthy"
  ok "restored"
}

# oppenheimer:begin runner
# --------------------------------------------------------- runner releases ---

# What hosts install and update from, served read-only by the `releases`
# container: public/install.sh, and public/releases → .releases/<set>, one
# directory per publish. A publish builds the next set beside the live one and
# repoints the link with a rename, so a host never reads a manifest from one
# release and its signature or artifacts from another. The tunnel routes only
# /releases/ and /install.sh there, so the sets themselves are not reachable.
PUBLIC="$ROOT/public"
RELEASE_SETS="$PUBLIC/.releases"
KEEP_RELEASE_SETS=3
# A ceiling on what stdin may carry, so a directory streamed by mistake stops.
PUBLISH_MAX_BYTES=500000000

# An OpenSSL that can verify Ed25519 over raw bytes (3.x), found the way the
# installer finds one. Ubuntu's is; macOS's LibreSSL, where tests may run, is not.
release_openssl() {
  local candidate
  for candidate in openssl /opt/homebrew/opt/openssl@3/bin/openssl /usr/local/opt/openssl@3/bin/openssl; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" version 2>/dev/null | grep -q '^OpenSSL 3'; then
      printf '%s' "$candidate"; return 0
    fi
  done
  return 1
}

file_sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }

# The release keys stamped into an installer (scripts/runner/release.sh).
installer_keys() { sed -n 's/^RELEASE_PUBLIC_KEYS="\([^"]*\)"$/\1/p' "$1" | head -n1; }

# signed_by <manifest> <signature file> "<keys>" — the installer's
# verify_manifest (scripts/runner/install.sh): 0 when one of the keys signed
# exactly these bytes.
signed_by() {
  local manifest="$1" signature="$2" keys="$3" ssl work key rc=1
  ssl="$(release_openssl)" || die "no OpenSSL 3 here, so a manifest signature cannot be checked"
  work="$(mktemp -d)"
  if "$ssl" base64 -d -A -in "$signature" -out "$work/sig.bin" 2>/dev/null && [ -s "$work/sig.bin" ]; then
    for key in $keys; do
      # An Ed25519 SubjectPublicKeyInfo is a fixed 12-byte header and the raw
      # key; the header is exactly 16 base64 characters, so the two concatenate.
      printf -- '-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA%s\n-----END PUBLIC KEY-----\n' "$key" > "$work/release.pub"
      if "$ssl" pkeyutl -verify -pubin -inkey "$work/release.pub" -rawin \
          -in "$manifest" -sigfile "$work/sig.bin" >/dev/null 2>&1; then
        rc=0; break
      fi
    done
  fi
  rm -rf "$work"
  return "$rc"
}

# check_release <dir> [--new-keys] — everything a publish refuses, checked
# before anything is touched: an installer carrying release keys; a manifest
# per channel whose signature verifies against them, and against the keys
# already published so the hosts in the field accept it; every artifact the
# manifest names present with its digest and size, on this server's /releases;
# and nothing else in the directory.
check_release() {
  local dir="$1" new_keys="${2:-}" keys key live_keys f channel manifests="" name file url want got size
  local base="https://$DEV_HOSTNAME/releases"
  local expected=" install.sh install.env SHA256SUMS "

  [ -d "$dir" ] || die "no such directory: $dir"
  [ -z "$(find "$dir" -mindepth 1 \( ! -type f -o -path "$dir/*/*" \) -print -quit)" ] \
    || die "$dir holds something other than plain files (a directory or a link); refusing"

  [ -s "$dir/install.sh" ] || die "no install.sh in $dir; publish the dist/runner directory release.sh wrote"
  keys="$(installer_keys "$dir/install.sh")"
  [ -n "$keys" ] || die "install.sh carries no release keys, so nothing it installs would be checked; refusing"
  for key in $keys; do
    [[ "$key" =~ ^[A-Za-z0-9+/]{43}=$ ]] || die "install.sh carries \"$key\", which is not a base64 Ed25519 public key"
  done

  for channel in stable beta; do
    [ -e "$dir/$channel.json" ] || continue
    manifests="$manifests $channel"
    expected="$expected$channel.json $channel.json.sig "
    [ -s "$dir/$channel.json.sig" ] || die "$channel.json has no $channel.json.sig; an unsigned manifest is never published"
    signed_by "$dir/$channel.json" "$dir/$channel.json.sig" "$keys" \
      || die "$channel.json.sig does not verify against the keys in install.sh; refusing"
    if [ -s "$PUBLIC/install.sh" ] && [ "$new_keys" != --new-keys ]; then
      live_keys="$(installer_keys "$PUBLIC/install.sh")"
      if [ -n "$live_keys" ] && ! signed_by "$dir/$channel.json" "$dir/$channel.json.sig" "$live_keys"; then
        die "$channel.json is not signed by a key the published runners trust ($live_keys), so no host already installed would take it. Sign it with that key, or pass --new-keys to strand them on purpose"
      fi
    fi

    jq -e --arg c "$channel" '.schema == "oppenheimer.release/v1" and .channel == $c
        and (.version | type == "string" and length > 0) and (.artifacts | type == "object" and length > 0)' \
        "$dir/$channel.json" >/dev/null 2>&1 \
      || die "$channel.json is not an oppenheimer.release/v1 manifest for the $channel channel"
    while IFS=$'\t' read -r name url want size; do
      file="${url##*/}"
      [ "$url" = "$base/$file" ] \
        || die "$channel.json points $name at $url, not at $base/ (build it with RELEASE_BASE_URL=$base)"
      [[ "$file" =~ ^runner_[0-9A-Za-z.+-]+_(darwin|linux)_(amd64|arm64)\.tar\.gz$ ]] \
        || die "$channel.json names an artifact this server does not serve: $file"
      [ -f "$dir/$file" ] || die "$channel.json names $file, which is not in $dir"
      got="$(file_sha256 "$dir/$file")"
      [ "$got" = "$want" ] || die "$file does not match $channel.json: sha256 $got, the manifest signed $want; refusing"
      [ "$(wc -c < "$dir/$file" | tr -d ' ')" = "$size" ] || die "$file is not the size $channel.json signed ($size bytes)"
      expected="$expected$file "
    done < <(jq -r '.artifacts | to_entries[] | [.key, .value.url, .value.sha256, (.value.size | tostring)] | @tsv' "$dir/$channel.json")
    ok "$channel.json $(jq -r .version "$dir/$channel.json") is signed and every artifact matches it"
  done
  [ -n "$manifests" ] || die "no stable.json or beta.json in $dir"

  if [ -e "$dir/install.env" ]; then
    [ "$(cat "$dir/install.env")" = "RUNNER_INSTALL_SHA256=$(file_sha256 "$dir/install.sh")" ] \
      || die "install.env does not hold install.sh's digest; the directory changed after release.sh wrote it"
  fi
  if [ -e "$dir/SHA256SUMS" ]; then
    while read -r want f; do
      f="${f#./}"
      [ -f "$dir/$f" ] && [ "$(file_sha256 "$dir/$f")" = "$want" ] || die "SHA256SUMS disagrees with $f"
    done < "$dir/SHA256SUMS"
  fi
  for f in "$dir"/*; do
    case "$expected" in
      *" ${f##*/} "*) ;;
      *) die "$dir has ${f##*/}, which no manifest names; refusing to publish it" ;;
    esac
  done
  ok "install.sh carries the release keys; its sha256 is $(file_sha256 "$dir/install.sh")"
}

# set_env <file> <KEY> <value> [--if-empty] — rewrite one KEY= line, or append
# it; the file is replaced with a rename and keeps its mode.
set_env() {
  local file="$1" key="$2" value="$3" only_empty="${4:-}" tmp
  if [ "$only_empty" = --if-empty ] && [ -n "$(sed -n "s/^$key=//p" "$file" | tail -n1)" ]; then return 0; fi
  tmp="$(mktemp "$file.XXXXXX")"
  chmod --reference="$file" "$tmp" 2>/dev/null || chmod 0600 "$tmp"
  awk -v k="$key" -v v="$value" 'BEGIN { done = 0 }
    index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }' "$file" > "$tmp"
  mv -f "$tmp" "$file"
}

# Hard-link a file of the live set into the next one, unless the publish
# brings its own. A file in a set is never written again once it lands there.
carry() { [ -e "$2/${1##*/}" ] || ln "$1" "$2/${1##*/}"; }

cmd_publish_release() {
  local src="" new_keys="" check_only="" work="" arg
  local usage="usage: oppctl publish-release [--check] [--new-keys] <dir | - for a tar on stdin>"
  for arg in "$@"; do
    case "$arg" in
      --new-keys) new_keys=--new-keys ;;
      --check) check_only=1 ;;
      -) src=- ;;
      -*) die "$usage" ;;
      *) src="$arg" ;;
    esac
  done
  [ -n "$src" ] || die "$usage"
  load_host_env
  [ -n "${DEV_HOSTNAME:-}" ] || die "DEV_HOSTNAME is empty in $CONFIG/host.env"

  if [ "$src" = - ]; then
    [ ! -t 0 ] || die "pipe a tar of the release directory into stdin"
    work="$(mktemp -d "$ROOT/.publish.XXXXXX")"
    # shellcheck disable=SC2064 # the path is fixed now, on purpose
    trap "rm -rf '$work'" EXIT
    head -c "$PUBLISH_MAX_BYTES" | tar -xf - -C "$work" --no-same-owner --no-same-permissions \
      || die "stdin is not a tar of the release directory"
    src="$work"
  fi
  check_release "$src" "$new_keys"
  [ -z "$check_only" ] || { ok "would publish (--check: nothing changed)"; return 0; }

  lock
  local stamp set live channel other version digest old_digest api_changed=0 rel f name
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  for channel in stable beta; do
    [ -e "$src/$channel.json" ] && version="$(jq -r .version "$src/$channel.json")" && break
  done
  set="$RELEASE_SETS/$stamp-$version"
  install -d -m 0755 "$RELEASE_SETS" "$set"
  for f in "$src"/*.tar.gz "$src"/*.json "$src"/*.json.sig "$src"/SHA256SUMS; do
    [ ! -e "$f" ] || install -m 0644 "$f" "$set/"
  done

  # A channel this publish does not carry keeps what it had, artifacts included.
  live="$(readlink -f "$PUBLIC/releases" 2>/dev/null || true)"
  if [ -n "$live" ] && [ -d "$live" ]; then
    for other in stable beta; do
      [ ! -e "$src/$other.json" ] && [ -s "$live/$other.json" ] && [ -s "$live/$other.json.sig" ] || continue
      carry "$live/$other.json" "$set"; carry "$live/$other.json.sig" "$set"
      while read -r f; do [ ! -f "$live/$f" ] || carry "$live/$f" "$set"; done \
        < <(jq -r '.artifacts[].url | sub(".*/"; "")' "$live/$other.json")
      log "kept the $other channel ($(jq -r .version "$live/$other.json"))"
    done
  fi

  # The first publish finds the directory `oppctl setup` made: it moves in
  # with the sets and the link takes its place, a gap of one rename.
  if [ -d "$PUBLIC/releases" ] && [ ! -L "$PUBLIC/releases" ]; then
    mv "$PUBLIC/releases" "$RELEASE_SETS/$stamp-before-publish"
  fi
  ln -sfn ".releases/${set##*/}" "$PUBLIC/.releases.next"
  mv -Tf "$PUBLIC/.releases.next" "$PUBLIC/releases"
  install -m 0644 "$src/install.sh" "$PUBLIC/.install.sh.next"
  mv -f "$PUBLIC/.install.sh.next" "$PUBLIC/install.sh"
  ok "published runner $version: /releases → ${set##*/}, and /install.sh"

  # The newest few sets stay, for a look at what was live before; never the live one.
  find "$RELEASE_SETS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r | tail -n +$((KEEP_RELEASE_SETS + 1)) \
    | while read -r name; do [ "$RELEASE_SETS/$name" = "$set" ] || rm -rf "${RELEASE_SETS:?}/$name"; done

  # The console shows the installer's digest under the install command.
  digest="$(file_sha256 "$PUBLIC/install.sh")"
  old_digest="$(sed -n 's/^RUNNER_INSTALL_SHA256=//p' "$CONFIG/api.env" | tail -n1)"
  cp -p "$CONFIG/api.env" "$CONFIG/api.env.before-publish"
  set_env "$CONFIG/api.env" RUNNER_INSTALL_SHA256 "$digest"
  set_env "$CONFIG/api.env" RUNNER_RELEASE_BASE_URL "https://$DEV_HOSTNAME/releases" --if-empty
  set_env "$CONFIG/api.env" RUNNER_INSTALL_URL "https://$DEV_HOSTNAME/install.sh" --if-empty
  cmp -s "$CONFIG/api.env" "$CONFIG/api.env.before-publish" || api_changed=1
  [ "$old_digest" = "$digest" ] || ok "RUNNER_INSTALL_SHA256=$digest in api.env"

  rel="$(current_release)"
  if [ -z "$rel" ]; then
    rm -f "$CONFIG/api.env.before-publish"
    warn "nothing is deployed yet; the API reads api.env on its first deploy"
    return 0
  fi
  compose "$rel" up -d releases
  for channel in stable beta; do
    [ -e "$set/$channel.json.sig" ] || continue
    compose "$rel" exec -T releases wget -qO /dev/null "http://127.0.0.1/releases/$channel.json.sig" \
      || warn "the releases container does not serve /releases/$channel.json.sig"
  done
  if [ "$api_changed" = 1 ]; then
    # The API reads api.env when it starts. nginx in web resolves `api` once,
    # when it starts, so it follows the API's new container.
    log "recreating the API (and the console's nginx) so it reads api.env"
    compose "$rel" up -d --no-deps --force-recreate api
    # oppenheimer:begin web
    wait_healthy "$rel" api && compose "$rel" up -d --no-deps --force-recreate web
    # oppenheimer:end web
    if ! verify_release "$rel"; then
      warn "the release did not come back healthy; putting the previous api.env back"
      mv -f "$CONFIG/api.env.before-publish" "$CONFIG/api.env"
      compose "$rel" up -d --no-deps --force-recreate api
      # oppenheimer:begin web
      compose "$rel" up -d --no-deps --force-recreate web
      # oppenheimer:end web
      die "the files are published but api.env is as it was; see 'oppctl logs api', then publish again"
    fi
  fi
  rm -f "$CONFIG/api.env.before-publish"
  ok "runner $version is live at https://$DEV_HOSTNAME/install.sh"
}
# oppenheimer:end runner

# ---------------------------------------------------------------- the rest ---

cmd_status() {
  load_host_env
  local rel; rel="$(need_current)"
  printf 'release   %s\n' "$(basename "$rel")"
  printf 'previous  %s\n' "$(basename "$(readlink -e "$PREVIOUS" 2>/dev/null || echo none)")"
  printf 'url       https://%s\n\n' "$DEV_HOSTNAME"
  [ -L "$INFLIGHT" ] && warn "a deploy of $(basename "$(readlink "$INFLIGHT")") was killed before it finished; the containers may be that release's — deploy again, or 'oppctl rollback'"
  compose "$rel" ps
  printf '\nlocal dumps:\n'
  docker run --rm --network none --entrypoint sh -v oppenheimer-dev_backup-work:/work:ro \
    "$(grep '^BACKUP_IMAGE=' "$rel/release.env" | cut -d= -f2-)" -c 'ls -1t /work/outbox/*.age 2>/dev/null | head -3' 2>/dev/null || true
  printf '\n'
  df -h / | tail -1
}

cmd_doctor() {
  load_host_env
  local bad=0
  check_config && ok "config files and host.env are filled in" || bad=1
  [[ "${AGE_RECIPIENT:-}" =~ ^age1[0-9a-z]{58}$ ]] && ok "AGE_RECIPIENT is an age public key" \
    || { warn "AGE_RECIPIENT is not an age public key (age1…)"; bad=1; }
  grep -q '^\[b2\]' "$CONFIG/rclone.conf" 2>/dev/null && [ -n "${B2_BUCKET:-}" ] && ok "B2 remote and bucket configured" \
    || { warn "no [b2] remote in rclone.conf or B2_BUCKET unset — weekly copy will fail"; bad=1; }
  [ -n "${NTFY_URL:-}" ] && ok "failures notify $NTFY_URL" || warn "NTFY_URL unset — failed backups alert nobody"
  [ -L "$INFLIGHT" ] && { warn "an interrupted deploy left $INFLIGHT (see 'oppctl status')"; bad=1; }
  for t in oppenheimer-backup-daily oppenheimer-backup-weekly oppenheimer-backup-check; do
    systemctl is-enabled --quiet "$t.timer" 2>/dev/null && ok "$t.timer enabled" || { warn "$t.timer not enabled"; bad=1; }
  done
  [ -e /var/run/reboot-required ] && warn "a reboot is due for security updates: sudo systemctl reboot"
  docker info >/dev/null 2>&1 && ok "docker reachable as $(id -un)" || { warn "docker not reachable as $(id -un)"; bad=1; }
  [ "$bad" -eq 0 ] && ok "ready" || die "not ready (see above)"
}

cmd_setup() {
  [ "$(id -u)" -eq 0 ] || die "setup runs as root"
  local ci_key=""
  [ "${1:-}" = --ci-key ] && ci_key="${2:-}"
  id deploy >/dev/null 2>&1 || die "no 'deploy' user (cloud-init.yaml creates it)"
  command -v openssl jq flock docker tee >/dev/null || die "need openssl, jq, flock and docker"
  [ -f "$HERE/config/host.env.example" ] || die "run setup from a checkout's deploy/dev, not the installed copy"

  install -d -o deploy -g deploy -m 0755 "$ROOT" "$RELEASES" "$ROOT/public" "$ROOT/public/releases"
  install -d -o deploy -g deploy -m 0700 "$CONFIG"

  gen() { [ -s "$CONFIG/$1" ] || { openssl rand -hex 32 > "$CONFIG/$1"; log "generated $1"; }; }
  gen db_password
  gen backup_db_password
  # Read by the postgres and backup containers as their own uids; the 0700
  # directory is what keeps other host users out.
  chmod 0644 "$CONFIG/db_password" "$CONFIG/backup_db_password"

  if [ ! -s "$CONFIG/host.env" ]; then
    install -m 0600 "$HERE/config/host.env.example" "$CONFIG/host.env"
    log "wrote $CONFIG/host.env — fill it in"
  fi
  if [ ! -s "$CONFIG/api.env" ]; then
    sed -e "s|@DB_PASSWORD@|$(cat "$CONFIG/db_password")|" \
        -e "s|@BETTER_AUTH_SECRET@|$(openssl rand -base64 32)|" \
        -e "s|@CONTROL_PLANE_SIGNING_KEY@|$(openssl genpkey -algorithm ed25519 -outform DER | base64 -w0)|" \
        -e "s|@GITHUB_USER_TOKEN_KEY@|$(openssl rand -base64 32)|" \
        "$HERE/config/api.env.example" > "$CONFIG/api.env"
    chmod 0600 "$CONFIG/api.env"
    log "wrote $CONFIG/api.env with fresh secrets — set the hostname in it"
  fi
  [ -e "$CONFIG/rclone.conf" ] || { : > "$CONFIG/rclone.conf"; chmod 0644 "$CONFIG/rclone.conf"; }
  chown -R deploy:deploy "$CONFIG"

  # The operator and the only thing the workflow's SSH key may run, root-owned
  # and outside every release.
  install -d -m 0755 -o root -g root "$LIBEXEC"
  install -m 0755 -o root -g root "$HERE/bin/oppctl" "$HERE/bin/deploy-gate" "$LIBEXEC/"
  ln -sfn "$LIBEXEC/oppctl" /usr/local/bin/oppctl
  if [ -n "$ci_key" ]; then
    install -d -o deploy -g deploy -m 0700 ~deploy/.ssh
    local line="command=\"$LIBEXEC/deploy-gate\",restrict $ci_key"
    grep -qxF "$line" ~deploy/.ssh/authorized_keys 2>/dev/null || printf '%s\n' "$line" >> ~deploy/.ssh/authorized_keys
    chown deploy:deploy ~deploy/.ssh/authorized_keys; chmod 0600 ~deploy/.ssh/authorized_keys
    log "authorized the CI key for the deploy gate only"
  fi

  install -m 0644 "$HERE"/systemd/*.service "$HERE"/systemd/*.timer /etc/systemd/system/
  systemctl daemon-reload
  systemctl enable --now oppenheimer-backup-daily.timer oppenheimer-backup-weekly.timer oppenheimer-backup-check.timer
  ok "setup done; next: fill in $CONFIG/host.env and $CONFIG/api.env, add tunnel-credentials.json and rclone.conf, then 'sudo -u deploy oppctl doctor'"
}

case "${1:-}" in
  setup)    shift; cmd_setup "$@" ;;
  doctor)   cmd_doctor ;;
  deploy)   shift; cmd_deploy "$@" ;;
  rollback) cmd_rollback ;;
  backup)   shift; cmd_backup "$@" ;;
  restore)  cmd_restore ;;
  # oppenheimer:begin runner
  publish-release) shift; cmd_publish_release "$@" ;;
  # oppenheimer:end runner
  status)   cmd_status ;;
  logs)     shift; load_host_env; compose "$(need_current)" logs --tail 200 "$@" ;;
  psql)     load_host_env; compose "$(need_current)" exec postgres psql -U oppenheimer oppenheimer ;;
  notify)   shift; load_host_env; notify "$*" ;;
  *) sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
