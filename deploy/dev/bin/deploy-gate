#!/usr/bin/env bash
# The forced command on the `Deploy dev` workflow's SSH key (installed by
# `oppctl setup` into /usr/local/libexec, root-owned, and named in
# ~deploy/.ssh/authorized_keys with `restrict`). The key gets no shell, no
# forwarding and no other command than:
#
#   deploy <40-char sha>    with a tar.gz on stdin: deploy/ (this directory at
#                           that commit) and registry-token (the workflow's
#                           short-lived GITHUB_TOKEN, to pull its images)
#
# What it does not do is narrow what a deploy can change: the bundle's oppctl
# runs as `deploy`, a member of the docker group, so whoever can run the
# workflow on main can change this server. The key, the tailnet ACL and the
# `dev` environment's branch rule are what guard that.
set -euo pipefail

read -r cmd sha rest <<< "${SSH_ORIGINAL_COMMAND:-}"
[ "$cmd" = deploy ] && [[ "${sha:-}" =~ ^[0-9a-f]{40}$ ]] && [ -z "${rest:-}" ] || {
  echo "deploy-gate: only 'deploy <sha>' is allowed" >&2
  exit 2
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
head -c 50000000 | tar -xzf - -C "$work" --no-same-owner --no-same-permissions deploy registry-token
chmod 0600 "$work/registry-token"
chmod 0755 "$work/deploy/bin/oppctl"
"$work/deploy/bin/oppctl" deploy "$sha" "$work"
