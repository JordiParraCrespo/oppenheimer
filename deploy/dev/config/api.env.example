# The API's environment on the dev server: /srv/oppenheimer/config/api.env
# (0600, owned by deploy). Every variable is documented in the repo's
# .env.example; this is the subset a dev deployment sets. `oppctl setup`
# fills the @…@ placeholders with fresh secrets. compose.yml overrides
# NODE_ENV, PORT, DB_HOST/PORT, REDIS_* and UPLOAD_DIR.

# The one public origin: nginx serves the console and proxies /api to the API.
FRONTEND_URL=https://dev.example.com
BETTER_AUTH_URL=https://dev.example.com
BETTER_AUTH_SECRET=@BETTER_AUTH_SECRET@
# Cloudflare's edge sets X-Forwarded-For; cloudflared and the web container's
# nginx pass it through unchanged, so the API trusts one hop.
TRUST_PROXY=1
AUTH_RATE_LIMIT_ENABLED=true

DB_USERNAME=oppenheimer
DB_PASSWORD=@DB_PASSWORD@
DB_DATABASE=oppenheimer

# console: emails are logged, not sent. Set resend or smtp to send them.
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@dev.example.com
RESEND_API_KEY=

# local keeps uploads in the oppenheimer-dev_uploads volume, which the dumps
# do not cover (Hetzner's server backups do). s3 works with R2 or Hetzner
# Object Storage — see .env.example.
STORAGE_PROVIDER=local

# Hosts: the control plane's Ed25519 key. Changing it orphans every paired host.
CONTROL_PLANE_SIGNING_KEY=@CONTROL_PLANE_SIGNING_KEY@
# Served by the `releases` container (README, "Runner releases"):
# https://<DEV_HOSTNAME>/releases and https://<DEV_HOSTNAME>/install.sh.
RUNNER_RELEASE_BASE_URL=
RUNNER_RELEASE_CHANNEL=stable
RUNNER_INSTALL_URL=
RUNNER_INSTALL_SHA256=

# GitHub sign-in and the GitHub App (optional; see .env.example).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_USER_TOKEN_KEY=@GITHUB_USER_TOKEN_KEY@

# Keep the queue dashboard off on an internet-facing deployment.
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
