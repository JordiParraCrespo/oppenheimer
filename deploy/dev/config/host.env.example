# This server's settings, read by oppctl and by compose for interpolation.
# Lives at /srv/oppenheimer/config/host.env (0600, owned by deploy).

# Where the `Deploy dev` workflow pushes images: ghcr.io/<owner>/<repo>, lowercase.
IMAGE_REPO=ghcr.io/jordiparracrespo/oppenheimer

# The public hostname the tunnel serves the console and API on, and the
# locally-managed tunnel's ID (`cloudflared tunnel create oppenheimer-dev`
# prints it; it is also TunnelID in tunnel-credentials.json).
DEV_HOSTNAME=dev.example.com
TUNNEL_ID=

# --- backups (db-backup-verify) -------------------------------------------
# age PUBLIC key (age1…). Dumps are encrypted to it before anything with
# internet access sees them. The private key is never on this server.
AGE_RECIPIENT=
# R2 bucket under a 30-day bucket lock (daily), B2 bucket under a 90-day
# Object Lock (weekly). Remotes `r2` and `b2` are defined in rclone.conf.
R2_BUCKET=
B2_BUCKET=

# Failed backups and failed deploys post here (https://ntfy.sh/<secret topic>,
# or your own ntfy). Empty: nobody is told.
NTFY_URL=
