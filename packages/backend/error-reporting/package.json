{
  "name": "@oppenheimer/backend-error-reporting",
  "version": "0.2.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js",
      "require": "./dist/init.js"
    }
  },
  "typesVersions": {
    "*": {
      "init": [
        "./dist/init.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@oppenheimer/backend-ddd": "workspace:*",
    "@sentry/nestjs": "^10.68.0"
  },
  "devDependencies": {
    "@nestjs/core": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@oppenheimer/tsconfig": "workspace:^",
    "@types/node": "^22.20.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
