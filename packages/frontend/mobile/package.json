{
  "name": "@oppenheimer/frontend-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "What both Expo apps share below their routes: analytics, config, forms, i18n, layout, platform glue, theme.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./config": "./src/config/index.ts",
