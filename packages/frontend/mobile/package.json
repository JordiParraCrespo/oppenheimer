    "expo-secure-store": "*",
    "i18next": "^26.0.0",
    "react": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-i18next": "^17.0.0",
    "react-native": ">=0.81.0",
    "react-native-mmkv": "*",
    "zod": "^3.0.0"
