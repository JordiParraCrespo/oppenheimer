{
  "name": "@oppenheimer/design-system-web",
  "version": "0.1.0",
  "sideEffects": [
    "**/*.css"
  ],
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/components/*.tsx",
    "./hooks/use-mobile": "./src/hooks/use-mobile.ts",
    "./styles": "./src/styles/globals.css",
    "./tailwind-config": "./tailwind.config.ts",
    "./utils": "./src/lib/utils.ts",
    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo node_modules",
    "test": "node scripts/check-exports.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.46.0",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
