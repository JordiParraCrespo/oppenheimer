{
  "$id": "https://oppenheimer.dev/schemas/protocol/v1/protocol.schema.json",
  "title": "Oppenheimer runner link protocol",
  "description": "Control messages on the runner link. PTY bytes travel as binary frames and are not described here.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "runnerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "protocol": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["min", "max"]
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "host": {
          "type": "object",
          "properties": {
            "hostname": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "type": "string",
              "minLength": 1
            },
            "arch": {
              "type": "string",
              "minLength": 1
            },
            "tools": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "agents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": ["claude-code", "codex"]
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["id", "version"]
              }
            }
          },
          "required": ["hostname", "os", "arch", "tools", "agents"]
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
              },
              "agent": {
                "type": "string",
                "enum": ["claude-code", "codex"]
              },
              "observed": {
                "type": "string",
                "enum": ["working", "blocked", "idle", "done", "unknown"]
              },
              "stateSeconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "windows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": ["index"]
                }
              },
              "agentSessionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reportHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "loginUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sessionId",
              "agent",
              "observed",
              "stateSeconds",
              "windows",
              "agentSessionId",
              "reportHash",
              "loginUrl"
            ]
          }
        }
      },
      "required": ["type", "runnerVersion", "protocol", "runId", "host", "sessions"]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "heartbeat"
        },
        "sentAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "runnerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "load": {
          "type": "object",
          "properties": {
            "loadAverage1m": {
              "type": "number",
              "minimum": 0
            },
            "workspacesFreeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["loadAverage1m", "workspacesFreeBytes"]
        },
        "tools": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
              },
              "agent": {
                "type": "string",
                "enum": ["claude-code", "codex"]
              },
              "observed": {
                "type": "string",
                "enum": ["working", "blocked", "idle", "done", "unknown"]
              },
              "stateSeconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "windows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": ["index"]
                }
              },
              "agentSessionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reportHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "loginUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sessionId",
              "agent",
              "observed",
              "stateSeconds",
              "windows",
              "agentSessionId",
              "reportHash",
              "loginUrl"
            ]
          }
        }
      },
      "required": ["type", "sentAt", "runnerVersion", "channel", "load", "tools", "sessions"]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hint"
        },
        "kind": {
          "type": "string",
          "enum": ["update_available", "update_required", "blocked", "host_offline"]
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["type", "kind"]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "events.append"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
        },
        "events": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "idempotencyKey": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+:\\d+$"
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "payload": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": ["idempotencyKey", "kind", "payload", "occurredAt"]
          }
        }
      },
      "required": ["type", "sessionId", "events"]
    },
    {
      "type": "object",
