              },
              "githubRepoId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "repositoryFullName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "directoryName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "baseBranch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            },
            "required": [
              "checkoutId",
              "githubRepoId",
              "repositoryFullName",
              "directoryName",
              "baseBranch"
            ]
          }
        },
        "cwdCheckoutId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "commandId",
        "sessionId",
        "organizationSlug",
        "projectSlug",
        "sessionSlug",
        "agent",
        "branch",
        "checkouts",
        "cwdCheckoutId"
