      "require": "./dist/schemas/role.schema.js",
      "default": "./dist/schemas/role.schema.js"
    },
    "./schemas/host": {
      "types": "./dist/schemas/host.schema.d.ts",
      "import": "./dist/schemas/host.schema.js",
      "require": "./dist/schemas/host.schema.js",
      "default": "./dist/schemas/host.schema.js"
    },
    "./schemas/project": {
      "types": "./dist/schemas/project.schema.d.ts",
      "import": "./dist/schemas/project.schema.js",
      "require": "./dist/schemas/project.schema.js",
      "default": "./dist/schemas/project.schema.js"
    },
    "./schemas/session": {
      "types": "./dist/schemas/session.schema.d.ts",
      "import": "./dist/schemas/session.schema.js",
      "require": "./dist/schemas/session.schema.js",
