{
  "name": "@oppenheimer/shared",
  "version": "0.2.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/protocol/messages.js",
    "./dist/protocol/primitives.js",
    "./dist/esm/protocol/messages.js",
    "./dist/esm/protocol/primitives.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.schema.d.ts",
      "import": "./dist/esm/schemas/*.schema.js",
      "require": "./dist/schemas/*.schema.js",
      "default": "./dist/schemas/*.schema.js"
    },
    "./feature-flags/catalog": {
      "types": "./dist/feature-flags/catalog.d.ts",
      "import": "./dist/esm/feature-flags/catalog.js",
      "require": "./dist/feature-flags/catalog.js",
      "default": "./dist/feature-flags/catalog.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/esm/*/index.js",
      "require": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "dist/*": [
        "./dist/*"
      ],
      "schemas/*": [
        "./dist/schemas/*.schema.d.ts"
      ],
      "feature-flags/catalog": [
        "./dist/feature-flags/catalog.d.ts"
      ],
      "*": [
        "./dist/*/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/write-esm-package-json.cjs && node scripts/emit-protocol-schema.cjs && node scripts/emit-link-protocol.cjs && node scripts/emit-agent-catalog.cjs && node scripts/emit-session-step.cjs && node scripts/emit-session-image.cjs",
    "check:generated": "node scripts/emit-protocol-schema.cjs --check && node scripts/emit-link-protocol.cjs --check && node scripts/emit-agent-catalog.cjs --check && node scripts/emit-session-step.cjs --check && node scripts/emit-session-image.cjs --check",
    "dev": "node scripts/write-esm-package-json.cjs && pnpm run \"/^dev:/\"",
    "dev:cjs": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:esm": "tsc -p tsconfig.esm.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "lint": "biome check src/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@oppenheimer/tsconfig": "workspace:^",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
