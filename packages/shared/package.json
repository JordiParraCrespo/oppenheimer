      "require": "./dist/scopes/index.js",
      "default": "./dist/scopes/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "lint": "biome check src/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@oppenheimer/tsconfig": "workspace:^",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
