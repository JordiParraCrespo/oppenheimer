  "typesVersions": {
    "*": {
      "agents": [
        "./dist/agents/index.d.ts"
      ],
      "protocol": [
        "./dist/protocol/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-protocol-schema.cjs && node scripts/emit-agent-catalog.cjs",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "lint": "biome check src/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "zod": "^3.25.76"
