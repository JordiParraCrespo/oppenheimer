      "require": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    },
    "./schemas/auth": {
      "types": "./dist/schemas/auth.schema.d.ts",
      "import": "./dist/schemas/auth.schema.js",
      "require": "./dist/schemas/auth.schema.js",
      "default": "./dist/schemas/auth.schema.js"
    },
    "./schemas/admin": {
      "types": "./dist/schemas/admin.schema.d.ts",
      "import": "./dist/schemas/admin.schema.js",
      "require": "./dist/schemas/admin.schema.js",
      "default": "./dist/schemas/admin.schema.js"
    },
    "./schemas/profile": {
      "types": "./dist/schemas/profile.schema.d.ts",
      "import": "./dist/schemas/profile.schema.js",
      "require": "./dist/schemas/profile.schema.js",
      "default": "./dist/schemas/profile.schema.js"
    },
    "./schemas/organization": {
      "types": "./dist/schemas/organization.schema.d.ts",
      "import": "./dist/schemas/organization.schema.js",
      "require": "./dist/schemas/organization.schema.js",
      "default": "./dist/schemas/organization.schema.js"
    },
    "./schemas/role": {
      "types": "./dist/schemas/role.schema.d.ts",
      "import": "./dist/schemas/role.schema.js",
