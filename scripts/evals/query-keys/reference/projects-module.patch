diff --git a/packages/frontend/consumer/src/react/projects.queries.ts b/packages/frontend/consumer/src/react/projects.queries.ts
new file mode 100644
index 0000000..b67d164
--- /dev/null
+++ b/packages/frontend/consumer/src/react/projects.queries.ts
@@ -0,0 +1,94 @@
+'use client';
+
+import { withCacheOnSuccess } from '@oppenheimer/frontend-core/react';
+import {
+  skipToken,
+  type UseMutationOptions,
+  type UseQueryOptions,
+  useMutation,
+  useQuery,
+  useQueryClient,
+} from '@tanstack/react-query';
+import type { ProjectEntity, ProjectFilters } from '../modules/projects/project.entity';
+import { useConsumerApp } from './context';
+
+/**
+ * Query key factory for the `projects` feature, one function per level:
+ *
+ * ```
+ * ['projects']                          all
+ * ['projects', 'list']                  lists()
+ * ['projects', 'list', filters]         list(filters)
+ * ['projects', 'detail']                details()
+ * ['projects', 'detail', id]            detail(id)
+ * ```
+ */
+export const projectsKeys = {
+  all: ['projects'] as const,
+  lists: () => [...projectsKeys.all, 'list'] as const,
+  list: (filters: ProjectFilters = {}) => [...projectsKeys.lists(), filters] as const,
+  details: () => [...projectsKeys.all, 'detail'] as const,
+  detail: (id: string | undefined) => [...projectsKeys.details(), id] as const,
+};
+
+export function useProjects(
+  filters: ProjectFilters = {},
+  options?: Omit<UseQueryOptions<ProjectEntity[], Error>, 'queryKey' | 'queryFn'>,
+) {
+  const app = useConsumerApp();
+
+  return useQuery({
+    queryKey: projectsKeys.list(filters),
+    queryFn: () => app.projects.findAll(filters),
+    ...options,
+  });
+}
+
+/** One project. A screen that has not resolved its id yet holds the read off. */
+export function useProject(
+  id: string | undefined,
+  options?: Omit<UseQueryOptions<ProjectEntity, Error>, 'queryKey' | 'queryFn'>,
+) {
+  const app = useConsumerApp();
+
+  return useQuery({
+    queryKey: projectsKeys.detail(id),
+    queryFn: id ? () => app.projects.findById(id) : skipToken,
+    ...options,
+  });
+}
+
+export interface RenameProjectVariables {
+  id: string;
+  name: string;
+}
+
+/** Writes the renamed row to its detail and refreshes the lists it appears in. */
+export function useRenameProject(
+  options?: UseMutationOptions<ProjectEntity, Error, RenameProjectVariables>,
+) {
+  const app = useConsumerApp();
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: ({ id, name }: RenameProjectVariables) => app.projects.rename(id, name),
+    ...withCacheOnSuccess(options, (project) => {
+      queryClient.setQueryData(projectsKeys.detail(project.id), project);
+      queryClient.invalidateQueries({ queryKey: projectsKeys.lists() });
+    }),
+  });
+}
+
+/** Drops the archived project's detail and refreshes the lists. */
+export function useArchiveProject(options?: UseMutationOptions<void, Error, string>) {
+  const app = useConsumerApp();
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: (id: string) => app.projects.archive(id),
+    ...withCacheOnSuccess(options, (_, id) => {
+      queryClient.removeQueries({ queryKey: projectsKeys.detail(id) });
+      queryClient.invalidateQueries({ queryKey: projectsKeys.lists() });
+    }),
+  });
+}
