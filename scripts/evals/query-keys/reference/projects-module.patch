@@ -0,0 +1,45 @@
+import { heyApiSdk, type ProjectResponseDto } from '@oppenheimer/api-client';
+import { AppError, MapApiError } from '@oppenheimer/frontend-core';
+import { injectable } from 'inversify';
+import { ProjectEntity, type ProjectFilters } from './project.entity';
+import { ProjectsErrors } from './projects.errors';
+
+function toEntity(data: ProjectResponseDto): ProjectEntity {
+  return new ProjectEntity(
+    data.id,
+    data.name,
+    data.slug,
+    new Date(data.createdAt),
+    new Date(data.updatedAt),
+  );
+}
+
+@injectable()
+export class ProjectsRepository {
+  @MapApiError(ProjectsErrors.FETCH_LIST_FAILED)
+  async findAll(filters: ProjectFilters = {}): Promise<ProjectEntity[]> {
+    const { data, error } = await heyApiSdk.listProjects({ query: filters });
+    if (error || !data) throw new AppError(ProjectsErrors.FETCH_LIST_FAILED);
+    return data.map(toEntity);
+  }
+
+  @MapApiError(ProjectsErrors.FETCH_FAILED)
+  async findById(id: string): Promise<ProjectEntity> {
+    const { data, error } = await heyApiSdk.getProject({ path: { id } });
+    if (error || !data) throw new AppError(ProjectsErrors.FETCH_FAILED);
+    return toEntity(data);
+  }
+
+  @MapApiError(ProjectsErrors.RENAME_FAILED)
+  async rename(id: string, name: string): Promise<ProjectEntity> {
+    const { data, error } = await heyApiSdk.updateProject({ path: { id }, body: { name } });
+    if (error || !data) throw new AppError(ProjectsErrors.RENAME_FAILED);
+    return toEntity(data);
+  }
+
+  @MapApiError(ProjectsErrors.ARCHIVE_FAILED)
+  async archive(id: string): Promise<void> {
+    const { error } = await heyApiSdk.archiveProject({ path: { id } });
+    if (error) throw new AppError(ProjectsErrors.ARCHIVE_FAILED);
+  }
+}
