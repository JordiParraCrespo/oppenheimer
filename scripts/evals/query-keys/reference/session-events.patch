+/**
+ * One page of a session's event log. The screen mounts before it knows the
+ * session, so an unknown id holds the query off with `skipToken`.
+ */
+export function useSessionEvents(
+  sessionId: string | undefined,
+  page: SessionEventsQuery = {},
+  options?: Omit<UseQueryOptions<SessionEventsPage, Error>, 'queryKey' | 'queryFn'>,
+) {
+  const app = useConsumerApp();
+
+  return useQuery({
+    queryKey: sessionsKeys.eventList(sessionId, page),
+    queryFn: sessionId ? () => app.sessions.events(sessionId, page) : skipToken,
+    ...options,
+  });
+}
