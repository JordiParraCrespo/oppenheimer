+export interface RenameHostVariables {
+  id: string;
+  name: string;
+}
+
+/**
+ * Rename a host. The saved row is written into the host list where it sits;
+ * pairing is left alone, since refetching a pairing detail mints a new token.
+ */
+export function useRenameHost(
+  options?: UseMutationOptions<HostEntity, Error, RenameHostVariables>,
+) {
+  const app = useConsumerApp();
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: ({ id, name }: RenameHostVariables) => app.hosts.rename(id, name),
+    onSuccess: (...args) => {
+      queryClient.invalidateQueries({ queryKey: hostsKeys.all });
+      options?.onSuccess?.(...args);
+    },
+    ...options,
+  });
+}
