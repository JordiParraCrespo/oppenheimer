{
  "$comment": "Read by scripts/starter/prune.mjs and the /starter-init skill. Every optional piece of the starter is a feature here; the paths are what goes when it is dropped, and every other place that mentions it is wrapped in `oppenheimer:begin <id>` / `oppenheimer:end <id>` markers. `pnpm starter:check` (CI) fails when a feature is referenced outside its paths and markers, so this file cannot go stale silently.",
  "features": {
    "web": {
      "title": "Consumer web app",
      "summary": "apps/web — Vite + TanStack Router SPA for end users",
      "identifiers": ["apps/web", "@oppenheimer/web", "oppenheimer-web"],
      "paths": ["apps/web", "e2e/tests/web", ".agents/skills/shadcn/evals/evals.json"],
      "scripts": ["dev:mvp"]
    },
    "web-showcase": {
      "title": "Web design-system showcase",
      "summary": "apps/web-showcase — Next.js gallery of @oppenheimer/design-system-web",
      "identifiers": ["apps/web-showcase", "@oppenheimer/web-showcase"],
      "paths": [
        "apps/web-showcase",
        ".agents/skills/design-export-port",
        ".agents/skills/next-best-practices",
        ".agents/skills/next-cache-components",
        ".agents/skills/next-upgrade",
        "packages/tsconfig/tsconfig.nextjs.json"
      ],
      "json": [
        {
          "file": "turbo.json",
          "path": "tasks.build.outputs",
          "remove": [".next/**", "!.next/cache/**"]
        },
        {
          "file": "biome.json",
          "path": "files.includes",
          "remove": ["!**/.next"]
        }
      ]
    },
    "docs": {
      "title": "Documentation site",
      "summary": "apps/docs — Docusaurus site (architecture, deployment, error catalog)",
      "identifiers": ["apps/docs", "@oppenheimer/docs", "oppenheimer-docs"],
      "paths": ["apps/docs", "apps/api/src/__tests__/error-catalog-coverage.spec.ts"]
    },
    "runner": {
      "title": "Go runner service",
      "summary": "apps/runner + packages/go/* — the Go host agent (pairing, launchd/systemd install, signed self-update) and the REST + WS service it grew from",
      "identifiers": [
        "apps/runner",
        "@oppenheimer/runner",
        "packages/go",
        "@oppenheimer/go-",
        "go.work",
        "golangci",
        "oppenheimer-runner",
        "RUNNER_"
      ],
      "paths": [
        "apps/runner",
        "packages/go",
        "scripts/runner",
        "go.work",
        ".golangci.yml",
        ".agents/rules/go.md",
        ".github/workflows/release-runner.yml",
        "apps/docs/docs/architecture/go-services.md",
        "e2e/fleet",
        "e2e/support/fleet.ts",
        "e2e/tests/fleet"
      ],
      "scripts": ["dev:mvp"]
    },
    "e2e": {
      "title": "End-to-end tests",
      "summary": "e2e/ — Playwright suites against the running API and web app",
      "identifiers": ["@oppenheimer/e2e", "e2e/"],
      "paths": ["e2e"],
      "scripts": ["test:e2e"]
    }
  },
  "shared": {
    "packages/frontend/design-system/web": {
      "identifiers": ["packages/frontend/design-system/web", "@oppenheimer/design-system-web"],
      "neededBy": ["web", "web-showcase"]
    },
    "packages/frontend/core": {
      "identifiers": ["packages/frontend/core", "@oppenheimer/frontend-core"],
      "neededBy": ["web"]
    },
    "packages/frontend/consumer": {
      "identifiers": ["packages/frontend/consumer", "@oppenheimer/frontend-consumer"],
      "neededBy": ["web"]
    },
    "packages/frontend/web": {
      "identifiers": ["packages/frontend/web", "@oppenheimer/frontend-web"],
      "neededBy": ["web"]
    },
    "packages/frontend/api-client": {
      "identifiers": ["packages/frontend/api-client", "@oppenheimer/api-client"],
      "neededBy": ["web"],
      "scripts": ["generate:api-client"]
    },
    "scripts/check-bundle-size.mjs": {
      "identifiers": ["check-bundle-size", "check:bundle"],
      "neededBy": ["web"],
      "scripts": ["check:bundle"]
    },
    "scripts/check-frontend-structure.mjs": {
      "identifiers": ["check-frontend-structure", "check:structure"],
      "neededBy": ["web"],
      "scripts": ["check:structure"]
    },
    "scripts/scaffold-feature.mjs": {
      "identifiers": ["scaffold-feature.mjs"],
      "neededBy": ["web"]
    },
    ".agents/skills/scaffold-feature": {
      "identifiers": [".agents/skills/scaffold-feature", "/scaffold-feature"],
      "neededBy": ["web"]
    },
    "packages/tsconfig/depcruise/frontend-app.cjs": {
      "identifiers": ["depcruise/frontend-app"],
      "neededBy": ["web"]
    },
    "packages/tsconfig/depcruise/frontend-kit.cjs": {
      "identifiers": ["depcruise/frontend-kit"],
      "neededBy": ["web"]
    }
  },
  "tooling": {
    "$comment": "The starter apparatus itself, removed at the end of a one-shot prune.",
    "paths": ["scripts/starter", ".agents/skills/starter-init"],
    "scripts": ["starter:prune", "starter:check"]
  }
}
