{
  "$comment": "Read by scripts/starter/prune.mjs and the /starter-init skill. Every optional piece of the starter is a feature here; the paths are what goes when it is dropped, and every other place that mentions it is wrapped in `oppenheimer:begin <id>` / `oppenheimer:end <id>` markers. `pnpm starter:check` (CI) fails when a feature is referenced outside its paths and markers, so this file cannot go stale silently.",
  "features": {
    "web": {
      "title": "Consumer web app",
      "summary": "apps/web — Vite + TanStack Router SPA for end users",
      "identifiers": ["apps/web", "@oppenheimer/web", "oppenheimer-web"],
      "paths": [
        "apps/web",
        "e2e/tests/web",
        "helm/oppenheimer/templates/web-deployment.yaml",
        ".agents/skills/shadcn/evals/evals.json"
      ],
      "scripts": ["dev:mvp"]
    },
    "mobile": {
      "title": "Consumer mobile app",
      "summary": "apps/mobile — Expo app for end users (NativeWind, expo-router)",
      "identifiers": ["apps/mobile", "@oppenheimer/mobile"],
      "paths": ["apps/mobile", "packages/frontend/nitro-app-info"]
    },
    "admin-web": {
      "title": "Admin control plane (web)",
      "summary": "apps/admin-web — Vite control plane for users, roles and permissions",
      "identifiers": ["apps/admin-web", "@oppenheimer/admin-web", "oppenheimer-admin-web"],
      "paths": ["apps/admin-web", "helm/oppenheimer/templates/admin-web-deployment.yaml"]
    },
    "admin-mobile": {
      "title": "Admin control plane (mobile)",
      "summary": "apps/admin-mobile — Expo control plane for users and roles",
      "identifiers": ["apps/admin-mobile", "@oppenheimer/admin-mobile"],
      "paths": ["apps/admin-mobile", "packages/frontend/nitro-app-info"]
    },
    "web-showcase": {
      "title": "Web design-system showcase",
      "summary": "apps/web-showcase — Next.js gallery of @oppenheimer/design-system-web",
      "identifiers": ["apps/web-showcase", "@oppenheimer/web-showcase"],
      "paths": [
        "apps/web-showcase",
        ".agents/skills/design-export-port",
        ".agents/skills/next-best-practices",
        ".agents/skills/next-cache-components",
        ".agents/skills/next-upgrade",
        "packages/tsconfig/tsconfig.nextjs.json"
      ],
      "json": [
        {
          "file": "turbo.json",
          "path": "tasks.build.outputs",
          "remove": [".next/**", "!.next/cache/**"]
        },
        {
          "file": "biome.json",
          "path": "files.includes",
          "remove": ["!**/.next"]
        }
      ]
    },
    "mobile-showcase": {
      "title": "Mobile design-system showcase",
      "summary": "apps/mobile-showcase — Expo gallery of @oppenheimer/design-system-mobile",
      "identifiers": ["apps/mobile-showcase", "@oppenheimer/mobile-showcase"],
      "paths": ["apps/mobile-showcase"]
    },
    "docs": {
      "title": "Documentation site",
      "summary": "apps/docs — Docusaurus site (architecture, deployment, error catalog)",
      "identifiers": ["apps/docs", "@oppenheimer/docs", "oppenheimer-docs"],
      "paths": [
        "apps/docs",
        "helm/oppenheimer/templates/docs-deployment.yaml",
        "apps/api/src/__tests__/error-catalog-coverage.spec.ts"
      ]
    },
    "cli": {
      "title": "Command-line interface",
      "summary": "apps/cli — `oppenheimer` CLI driven by scoped API tokens",
      "identifiers": ["apps/cli", "@oppenheimer/cli"],
      "paths": ["apps/cli", "apps/docs/docs/tooling/cli.md"]
    },
    "mcp": {
      "title": "MCP server",
      "summary": "apps/mcp — Model Context Protocol server (stdio + Streamable HTTP) over the API",
      "identifiers": ["apps/mcp", "@oppenheimer/mcp", "oppenheimer-mcp"],
      "paths": ["apps/mcp", "apps/docs/docs/tooling/mcp.md"]
    },
    "runner": {
      "title": "Go runner service",
      "summary": "apps/runner + packages/go/* — Go service template (REST + WS, API keys) the API delegates long-lived work to",
      "identifiers": [
        "apps/runner",
        "@oppenheimer/runner",
        "packages/go",
        "@oppenheimer/go-",
        "go.work",
        "golangci",
        "oppenheimer-runner",
        "RUNNER_"
      ],
      "paths": [
        "apps/runner",
        "packages/go",
        "go.work",
        ".golangci.yml",
        ".agents/rules/go.md",
        "apps/docs/docs/architecture/go-services.md",
        "helm/oppenheimer/templates/runner-deployment.yaml"
      ],
      "scripts": ["dev:mvp"]
    },
    "e2e": {
      "title": "End-to-end tests",
      "summary": "e2e/ — Playwright suites against the running API and web app",
      "identifiers": ["@oppenheimer/e2e", "e2e/"],
      "paths": ["e2e"],
      "scripts": ["test:e2e"]
    },
    "qa": {
      "title": "QA scenario pack",
      "summary": "qa/ — scenario-driven Playwright QA pack with maturity tracking and screenshots",
      "identifiers": ["@oppenheimer/qa", "qa/"],
      "paths": ["qa", "plans", "docs/screenshots"],
      "requires": ["web", "admin-web", "e2e"],
      "scripts": ["qa", "qa:suite", "qa:coverage"],
      "$comment": "plans/ holds only the QA pack's implementation plans and docs/screenshots is the curated QA run output, so both belong to it."
    },
    "helm": {
      "title": "Kubernetes Helm chart",
      "summary": "helm/ — chart for the Tier 2 (Kubernetes) deployment",
      "identifiers": ["helm/"],
      "paths": ["helm", "apps/docs/docs/deployment/tier-2-production.md"]
    }
  },
  "shared": {
    "packages/frontend/design-system/web": {
      "identifiers": ["packages/frontend/design-system/web", "@oppenheimer/design-system-web"],
      "neededBy": ["web", "admin-web", "web-showcase"]
    },
    "packages/frontend/design-system/mobile": {
      "identifiers": [
        "packages/frontend/design-system/mobile",
        "@oppenheimer/design-system-mobile"
      ],
      "neededBy": ["mobile", "admin-mobile", "mobile-showcase"]
    },
    "packages/frontend/core": {
      "identifiers": ["packages/frontend/core", "@oppenheimer/frontend-core"],
      "neededBy": ["web", "mobile", "admin-web", "admin-mobile"]
    },
    "packages/frontend/consumer": {
      "identifiers": ["packages/frontend/consumer", "@oppenheimer/frontend-consumer"],
      "neededBy": ["web", "mobile"]
    },
    "packages/frontend/admin": {
      "identifiers": ["packages/frontend/admin", "@oppenheimer/frontend-admin"],
      "neededBy": ["admin-web", "admin-mobile"]
    },
    "packages/frontend/web": {
      "identifiers": ["packages/frontend/web", "@oppenheimer/frontend-web"],
      "neededBy": ["web", "admin-web"]
    },
    "packages/frontend/mobile": {
      "identifiers": ["packages/frontend/mobile", "@oppenheimer/frontend-mobile"],
      "neededBy": ["mobile", "admin-mobile"]
    },
    "packages/frontend/api-client": {
      "identifiers": ["packages/frontend/api-client", "@oppenheimer/api-client"],
      "neededBy": ["web", "mobile", "admin-web", "admin-mobile"],
      "scripts": ["generate:api-client"]
    },
    "apps/docs/docs/tooling/permissions.md": {
      "identifiers": [],
      "neededBy": ["cli", "mcp"]
    },
    "scripts/check-bundle-size.mjs": {
      "identifiers": ["check-bundle-size", "check:bundle"],
      "neededBy": ["web", "admin-web"],
      "scripts": ["check:bundle"]
    },
    "packages/tsconfig/tsconfig.expo.json": {
      "$comment": "Everything Expo leaves in the kept apps: the Better Auth expo plugin in apps/api, the EXPO_PUBLIC_* pass-through in turbo.json, the react-native override.",
      "identifiers": ["tsconfig.expo", "EXPO_PUBLIC_", "@better-auth/expo", "react-native"],
      "neededBy": ["mobile", "admin-mobile", "mobile-showcase"],
      "json": [
        {
          "file": "turbo.json",
          "path": "tasks.build.env",
          "remove": ["EXPO_PUBLIC_*"]
        },
        {
          "file": "package.json",
          "path": "pnpm.overrides",
          "deleteKeys": ["react-native"]
        },
        {
          "file": "apps/api/package.json",
          "path": "dependencies",
          "deleteKeys": ["@better-auth/expo"]
        },
        {
          "file": "biome.json",
          "path": "files.includes",
          "remove": ["!**/.expo"]
        }
      ]
    },
    "scripts/check-frontend-structure.mjs": {
      "identifiers": ["check-frontend-structure", "check:structure"],
      "neededBy": ["web", "admin-web", "mobile", "admin-mobile"],
      "scripts": ["check:structure"]
    },
    "scripts/scaffold-feature.mjs": {
      "identifiers": ["scaffold-feature.mjs"],
      "neededBy": ["web", "admin-web", "mobile", "admin-mobile"]
    },
    ".agents/skills/scaffold-feature": {
      "identifiers": [".agents/skills/scaffold-feature", "/scaffold-feature"],
      "neededBy": ["web", "admin-web", "mobile", "admin-mobile"]
    },
    "packages/tsconfig/depcruise/frontend-app.cjs": {
      "identifiers": ["depcruise/frontend-app"],
      "neededBy": ["web", "admin-web", "mobile", "admin-mobile"]
    },
    "packages/tsconfig/depcruise/frontend-kit.cjs": {
      "identifiers": ["depcruise/frontend-kit"],
      "neededBy": ["web", "admin-web", "mobile", "admin-mobile"]
    }
  },
  "tooling": {
    "$comment": "The starter apparatus itself, removed at the end of a one-shot prune.",
    "paths": ["scripts/starter", ".agents/skills/starter-init"],
    "scripts": ["starter:prune", "starter:check"]
  }
}
