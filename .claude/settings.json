{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // .file_path' | { read -r f; pnpm exec biome format --write --files-ignore-unknown=true \"$f\"; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting with Biome..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".agents/hooks/arch-check.sh",
            "timeout": 180,
            "statusMessage": "Checking API architecture boundaries..."
          }
        ]
      }
    ]
  }
}
