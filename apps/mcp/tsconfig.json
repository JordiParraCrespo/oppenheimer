{
  "extends": "@oppenheimer/config/tsconfig.library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // `node16` rather than plain `node`: the MCP SDK v2 packages expose their
    // entrypoints through an `exports` map (`@modelcontextprotocol/server/stdio`),
    // which the legacy resolver cannot see. The package stays CommonJS, so the
    // `require` condition resolves to the SDK's `.cjs`/`.d.cts` build.
    "module": "node16",
    "moduleResolution": "node16"
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/**/__tests__/**"]
}
