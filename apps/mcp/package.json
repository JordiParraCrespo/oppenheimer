{
  "name": "@oppenheimer/mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Model Context Protocol server exposing the Oppenheimer API with granular, per-tool permissions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oppenheimer-mcp": "./dist/bin/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/bin/stdio.js",
    "start:http": "node dist/bin/http.js",
    "lint": "biome check src/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oppenheimer/env": "workspace:*",
    "@oppenheimer/shared": "workspace:*",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@oppenheimer/config": "workspace:^",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
