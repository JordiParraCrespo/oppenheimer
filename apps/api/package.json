{
  "name": "@oppenheimer/api",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome check src/",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typeorm": "TS_NODE_PROJECT=tsconfig.typeorm.json typeorm-ts-node-commonjs",
    "migration:generate": "pnpm typeorm migration:generate -d src/config/data-source.ts",
    "migration:run": "pnpm typeorm migration:run -d src/config/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/config/data-source.ts",
    "generate:openapi": "pnpm exec nest build && OPENAPI_GENERATION=true node dist/generate-openapi.js",
    "seed": "TS_NODE_PROJECT=tsconfig.typeorm.json ts-node src/database/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@oppenheimer/auth": "workspace:*",
    "@oppenheimer/backend-authz": "workspace:*",
    "@oppenheimer/backend-cache": "workspace:*",
    "@oppenheimer/backend-core": "workspace:*",
    "@oppenheimer/backend-ddd": "workspace:*",
    "@oppenheimer/backend-email": "workspace:*",
    "@oppenheimer/backend-i18n": "workspace:*",
    "@oppenheimer/backend-llm": "workspace:*",
    "@oppenheimer/backend-queue": "workspace:*",
    "@oppenheimer/backend-storage": "workspace:*",
    "@oppenheimer/env": "workspace:*",
    "@oppenheimer/shared": "workspace:*",
    "@oppenheimer/translations": "workspace:*",
    "@sentry/nestjs": "^10.68.0",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.6.25",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "multer": "2.2.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^4.3.1",
    "oxide.ts": "^1.1.0",
    "pg": "^8.22.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "ws": "^8.21.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@oppenheimer/tsconfig": "workspace:^",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "dependency-cruiser": "^18.1.0",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^5.0.0"
  }
}
